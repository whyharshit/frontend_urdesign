# Frontend renderer only. The business API runs separately.
PORT=5173
# Future API adapter; setting this does not enable real accounts or payments.
VITE_API_BASE_URL=http://localhost:4000/api
# Show demo helpers (Demo guide, preview banners) on a staging deploy. Off in production builds.
VITE_STAGING=false
# Frontend-only admin gate for the preview. Real admin access must be enforced by the backend.
VITE_ADMIN_EMAIL=admin@urdesigner.in
VITE_ADMIN_PASSWORD=change-me
# Public site address for canonical links, link previews and sitemap.xml
VITE_SITE_URL=https://frontend-urdesign.vercel.app
